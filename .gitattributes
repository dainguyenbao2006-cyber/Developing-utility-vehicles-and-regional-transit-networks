# Chuẩn hóa line endings giữa Windows (dev) và Linux (Google Colab)
* text=auto

*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.sh text eol=lf
*.ipynb text eol=lf

*.ps1 text eol=crlf

# Binary files
*.pt binary
*.pth binary
*.onnx binary
*.mp4 binary
*.avi binary
*.png binary
*.jpg binary
