# Sao chép file này thành ".env" và điền đường dẫn thực tế trên máy của bạn
# Không commit file ".env" lên Git

# Đường dẫn thư mục gốc dataset
BDD_ROOT=D:/datasets/bdd100k
CITYSCAPES_ROOT=D:/datasets/cityscapes

# Đường dẫn trọng số & output
WEIGHTS_DIR=weights
OUTPUT_DIR=outputs

# Cấu hình thiết bị (cuda hoặc cpu)
DEVICE=cuda

# (Tùy chọn) Kaggle API nếu tải BDD100K bằng kagglehub
KAGGLE_USERNAME=
KAGGLE_KEY=
